{
  "name": "self-hosted-rtc",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.32.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --config vitest.root.config.ts && pnpm -r --if-present test",
    "test:contract": "vitest run --config vitest.root.contract.config.ts",
    "test:integration": "vitest run --config vitest.root.integration.config.ts && pnpm -r --if-present test:integration",
    "test:e2e:desktop": "pnpm --filter @wo/desktop test:e2e",
    "test:e2e:web": "pnpm --filter @wo/web test:e2e",
    "lint": "eslint . --ignore-pattern apps/desktop/out-acceptance --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
