# Local-only integration settings. Copy to deploy/.env.integration.
APP_DOMAIN=rtc.localhost
ACME_EMAIL=integration@localhost.invalid

POSTGRES_DB=wo_integration
POSTGRES_USER=wo_integration

PUBLIC_IPV4=127.0.0.1
TURN_HOST=turn.localhost
TURN_REALM=turn.localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_URLS=stun:turn.localhost:3478,turn:turn.localhost:3478?transport=udp,turn:turn.localhost:3478?transport=tcp,turns:turn.localhost:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600

ROOM_CODE_TTL_SECONDS=600
ROOM_DISCONNECT_GRACE_SECONDS=120
SCREEN_LEASE_TTL_SECONDS=15
SCREEN_BITRATE_MIN=1000000
SCREEN_BITRATE_MAX=20000000

DEPLOY_SECRET_DIR=./secrets.integration
BACKUP_DIR=./backups.integration
