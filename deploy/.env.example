# Production P2P server settings. Replace every change-me value before deploy.
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Public HTTPS origin served by this self-hosted deployment.
PUBLIC_URL=https://change-me.invalid

# PostgreSQL owned by this deployment. Task 7 adds the container credentials.
DATABASE_URL=postgres://change-me:change-me@change-me.invalid:5432/change-me

# Generate JWT_ACCESS_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=change-me

# Generate TURN_SHARED_SECRET independently by running:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TURN_SHARED_SECRET=change-me

# TURN_HOST must be a DNS name you operate and must match every URL below.
# Do not replace these entries with public or third-party STUN/TURN services.
TURN_REALM=change-me.invalid
TURN_HOST=change-me.invalid
TURN_URLS=stun:change-me.invalid:3478,turn:change-me.invalid:3478?transport=udp,turn:change-me.invalid:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600

# Temporary two-person room and disconnect recovery windows.
ROOM_CODE_TTL_SECONDS=600
ROOM_DISCONNECT_GRACE_SECONDS=120

# Single-screen lease and adjustable sender bitrate bounds.
SCREEN_LEASE_TTL_SECONDS=15
SCREEN_BITRATE_MIN=1000000
SCREEN_BITRATE_MAX=10000000
