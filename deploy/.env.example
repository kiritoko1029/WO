# Copy to deploy/.env and replace every example value before production use.
APP_DOMAIN=rtc.example.com
ACME_EMAIL=operator@example.com

# PostgreSQL is private to this Compose project. Its password is a secret file.
POSTGRES_DB=wo
POSTGRES_USER=wo

# Public TURN identity and the host IPv4 advertised in relay candidates.
PUBLIC_IPV4=203.0.113.10
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=600

# Temporary two-person room and disconnect recovery windows.
ROOM_CODE_TTL_SECONDS=600
ROOM_DISCONNECT_GRACE_SECONDS=120

# Single-screen lease and adjustable sender bitrate bounds.
SCREEN_LEASE_TTL_SECONDS=15
SCREEN_BITRATE_MIN=1000000
SCREEN_BITRATE_MAX=20000000

# Email security (optional)
# Comma-separated allowlist. Empty = all domains allowed.
EMAIL_DOMAIN_ALLOWLIST=
# Set true to require SMTP verification before login.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_CODE_TTL_SECONDS=600
# Comma-separated super-admin emails that can open /admin.
SUPER_ADMIN_EMAILS=
# SMTP settings (required when EMAIL_VERIFICATION_REQUIRED=true in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Paths are resolved relative to deploy/. Keep both outside public web roots.
DEPLOY_SECRET_DIR=./secrets
BACKUP_DIR=./backups
