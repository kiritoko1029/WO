{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "electron", "vite/client"],
    "paths": {
      "@wo/media-policy": ["../../packages/media-policy/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.d.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
