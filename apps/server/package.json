{
  "name": "@wo/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "predev": "pnpm --filter @wo/config build && pnpm --filter @wo/database build && pnpm --filter @wo/protocol build",
    "dev": "node --watch --env-file-if-exists=../../deploy/.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.3.0",
    "@wo/config": "workspace:*",
    "@wo/database": "workspace:*",
    "@wo/protocol": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1"
  }
}
